@model IEnumerable<Nva_Lesson10.Models.NvaMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TvcUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvcPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvcFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvcEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvcPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvcStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TvcUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.TvcPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.TvcFullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.TvcEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.TvcPhone)
            </td>
            <td>
                @Html.DisplayFor(model => item.TvcStatus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
