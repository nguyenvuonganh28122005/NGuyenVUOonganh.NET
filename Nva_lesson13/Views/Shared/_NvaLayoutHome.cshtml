<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/NvaLayoutHome.css" />
</head>
<body>

    <nav class="container border-1 my-1">
        <div>
            <a href="/Products/Index" title="Danh sách sản phẩm">Danh sách sản phẩm</a>
            <a asp-action="Search" asp-controller="Products">Tìm kiếm sản phẩm</a>
            <a asp-action="Hots" asp-controller="Products">Sản phẩm bán chạy</a>
            <a href="/Products/About">Giới thiệu</a>
        </div>
    </nav>

    <div class="container border-1 my-1">
        @RenderBody()
    </div>

    <footer class="container border-1 my-1">
        <p style="text-align:center">
            &copy; 10/2026 <br />
            Copyright by @@VUONG ANH
            <br />
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </p>
    </footer>

</body>
</html>