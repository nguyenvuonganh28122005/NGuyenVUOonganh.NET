@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title fw-bold m-0 fs-6 text-dark">
            <i class="bi bi-box-seam me-2 text-primary"></i>Danh sách sản phẩm trong kho
        </h5>
        <div class="card-tools">
            <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Thêm mới sản phẩm
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3 text-secondary fs-7">#</th>
                        <th class="text-secondary fs-7">Hình ảnh</th>
                        <th class="text-secondary fs-7">Tên sản phẩm</th>
                        <th class="text-secondary fs-7">Danh mục</th>
                        <th class="text-secondary fs-7">Đơn giá</th>
                        <th class="text-secondary fs-7">Số lượng</th>
                        <th class="text-secondary fs-7">Trạng thái</th>
                        <th class="text-end pe-3 text-secondary fs-7">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-3 fw-semibold text-primary">SP001</td>
                        <td>
                            <img src="~/admin-lte-v4.10.0/dist/assets/img/prod-1.jpg" alt="Laptop Dell XPS" class="rounded shadow-sm" style="width: 48px; height: 48px; object-fit: cover;">
                        </td>
                        <td>
                            <span class="fw-semibold text-dark">Laptop Dell XPS 15</span>
                            <small class="d-block text-muted">Core i7, 16GB RAM, 512GB SSD</small>
                        </td>
                        <td><span class="badge text-bg-light border">Laptop</span></td>
                        <td class="fw-bold text-primary">25.000.000đ</td>
                        <td><span class="badge text-bg-info text-white">15 cái</span></td>
                        <td><span class="badge text-bg-success">Còn hàng</span></td>
                        <td class="text-end pe-3">
                            <button class="btn btn-sm btn-outline-secondary me-1" title="Chỉnh sửa"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold text-primary">SP002</td>
                        <td>
                            <img src="~/admin-lte-v4.10.0/dist/assets/img/prod-2.jpg" alt="iPhone 15 Pro" class="rounded shadow-sm" style="width: 48px; height: 48px; object-fit: cover;">
                        </td>
                        <td>
                            <span class="fw-semibold text-dark">iPhone 15 Pro Max 256GB</span>
                            <small class="d-block text-muted">Titan Tự Nhiên, Apple A17 Pro</small>
                        </td>
                        <td><span class="badge text-bg-light border">Điện thoại</span></td>
                        <td class="fw-bold text-primary">32.000.000đ</td>
                        <td><span class="badge text-bg-info text-white">28 cái</span></td>
                        <td><span class="badge text-bg-success">Còn hàng</span></td>
                        <td class="text-end pe-3">
                            <button class="btn btn-sm btn-outline-secondary me-1" title="Chỉnh sửa"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold text-primary">SP003</td>
