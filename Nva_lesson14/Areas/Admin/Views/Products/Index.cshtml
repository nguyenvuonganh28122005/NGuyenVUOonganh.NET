                        <td><span class="badge text-bg-warning text-dark">Sắp hết</span></td>
                        <td class="text-end pe-3">
                            <button class="btn btn-sm btn-outline-secondary me-1" title="Chỉnh sửa"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold text-primary">SP005</td>
                        <td>
                            <img src="~/admin-lte-v4.10.0/dist/assets/img/prod-5.jpg" alt="iPad Pro 11" class="rounded shadow-sm" style="width: 48px; height: 48px; object-fit: cover;">
                        </td>
                        <td>
                            <span class="fw-semibold text-dark">iPad Pro 11" M2 Wifi 128GB</span>
                            <small class="d-block text-muted">Silver, Liquid Retina, 120Hz</small>
                        </td>
                        <td><span class="badge text-bg-light border">Máy tính bảng</span></td>
