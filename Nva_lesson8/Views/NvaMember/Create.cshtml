@model Nva_lesson8.Models.NvaMember

@{
    ViewData["Title"] = "Thêm thành viên";
}

<div class="card p-3">
    <div class="card-header">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="NvaMemberId" class="control-label fw-bold"></label>
                        <input asp-for="NvaMemberId" class="form-control" />
                        <span asp-validation-for="NvaMemberId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="NvaUserName" class="control-label fw-bold"></label>
                        <input asp-for="NvaUserName" class="form-control" />
                        <span asp-validation-for="NvaUserName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="NvaPassword" class="control-label fw-bold"></label>
                        <input asp-for="NvaPassword" type="password" class="form-control" />
                        <span asp-validation-for="NvaPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="NvaFullName" class="control-label fw-bold"></label>
                        <input asp-for="NvaFullName" class="form-control" />
                        <span asp-validation-for="NvaFullName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="NvaEmail" class="control-label fw-bold"></label>
                        <input asp-for="NvaEmail" type="email" class="form-control" />
                        <span asp-validation-for="NvaEmail" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3">
                        <input type="submit" value="Tạo mới" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}