@model Nva_lesson8.Models.NvaMember

@{
    ViewData["Title"] = "Chỉnh sửa thành viên";
}

<div class="card p-3">
    <div class="card-header">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @* Hidden input lưu ID *@
            <input type="hidden" asp-for="NvaMemberId" />

            <div class="mb-3">
                <label asp-for="NvaUserName" class="form-label"></label>
                <input asp-for="NvaUserName" class="form-control" />
                <span asp-validation-for="NvaUserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NvaPassword" class="form-label"></label>
                <input asp-for="NvaPassword" type="password" class="form-control" />
                <span asp-validation-for="NvaPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NvaFullName" class="form-label"></label>
                <input asp-for="NvaFullName" class="form-control" />
                <span asp-validation-for="NvaFullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NvaEmail" class="form-label"></label>
                <input asp-for="NvaEmail" class="form-control" />
                <span asp-validation-for="NvaEmail" class="text-danger"></span>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}